#!/bin/bash
#$ -cwd
#$ -j y
#$ -o New_simulations/hoffman2/logs/audit.$JOB_ID.log
#$ -N dm_audit
#$ -l highp,h_rt=2:00:00,h_data=8G,h_vmem=16G
#$ -pe shared 2

set -euo pipefail

. /u/local/Modules/default/init/modules.sh
module load gcc/10.2.0
module load R/4.2.2

export R_LIBS_USER="$HOME/R/hoffman2-4.2.2-gcc10"
export OMP_NUM_THREADS="$NSLOTS"
export OMP_DYNAMIC=FALSE
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

echo "job=$JOB_ID host=$(hostname) slots=$NSLOTS start=$(date --iso-8601=seconds)"
provenance_dir=New_simulations/outputs/hoffman2_environment
mkdir -p "$provenance_dir"
sha256sum \
  New_simulations/DM_RJMCMC_VS_sampler_online_adaptive.cpp \
  New_simulations/dm_stable_numerics.h \
  New_simulations/dm_validate_chain.R \
  New_simulations/run_dm_numerical_stability_audit.R \
  New_simulations/run_dm_online_adaptation_audit.R \
  New_simulations/run_dm_optional_coefficient_updates_audit.R \
  New_simulations/run_real_data_convergence_experiment.R \
  New_simulations/summarize_real_data_convergence.R \
  New_simulations/summarize_real_data_coefficient_pilot.R \
  New_simulations/hoffman2/mixture_pilot_array.qsub \
  New_simulations/hoffman2/mixture_pilot_summary.qsub \
  'Real Data Analysis/Data/combo_count_tab.txt' \
  'Real Data Analysis/Data/udiet.adj.scale.txt' \
  'Real Data Analysis/Data/ffq.labels2.txt' \
  > "$provenance_dir/source_and_data_sha256.txt"
Rscript -e 'cat("R=", R.version.string, "\n"); print(sessionInfo())'
Rscript -e 'writeLines(capture.output(sessionInfo()), "New_simulations/outputs/hoffman2_environment/sessionInfo.txt")'
Rscript -e 'expected <- c(Rcpp="1.0.12",RcppArmadillo="15.2.3.1",RcppEigen="0.3.4.0.2",RcppEnsmallen="0.2.22.1.1",huge="1.3.5"); actual <- vapply(names(expected), function(x) as.character(packageVersion(x)), character(1)); print(actual); stopifnot(identical(unname(actual), unname(expected)))'
# Run the diagnostic suite single-threaded.  This prevents an exception from
# being thrown through an OpenMP worker (which otherwise appears only as an
# uninformative "terminate called recursively" abort).  The sampler audit
# immediately below remains on the Grid Engine allocation.
export OMP_NUM_THREADS=1
Rscript New_simulations/run_dm_numerical_stability_audit.R
export OMP_NUM_THREADS="$NSLOTS"
Rscript New_simulations/run_dm_online_adaptation_audit.R \
  --output=New_simulations/outputs/dm_online_adaptation_audit

Rscript -e 'x <- read.csv("New_simulations/outputs/dm_online_adaptation_audit/summary.csv"); stopifnot(nrow(x) == 1L, isTRUE(as.logical(x$passed[[1]]))); print(x)'
export OMP_NUM_THREADS=1
Rscript New_simulations/run_dm_optional_coefficient_updates_audit.R
Rscript -e 'for (d in c("dm_numerical_stability_audit", "dm_online_adaptation_audit", "dm_optional_coefficient_updates_audit")) { x <- read.csv(file.path("New_simulations/outputs",d,"summary.csv")); stopifnot(nrow(x)==1L,isTRUE(x$passed[[1]])); cat("PASSED:",d,"\n"); print(x) }'
echo "ALL THREE DM AUDITS PASSED"
echo "job=$JOB_ID end=$(date --iso-8601=seconds)"
