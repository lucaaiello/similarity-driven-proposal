#!/bin/bash
#$ -cwd
#$ -j y
#$ -o New_simulations/dm_apt50k_fresh_v1/hoffman2/logs/ladder.$JOB_ID.$TASK_ID.log
#$ -N apt50_fresh
#$ -l highp,h_rt=120:00:00,h_data=4G,h_vmem=40G
#$ -pe shared 10
#$ -t 1-12:1
#$ -tc 6
set -euo pipefail
. /u/local/Modules/default/init/modules.sh
module load gcc/10.2.0
module load R/4.2.2
export R_LIBS_USER="$HOME/R/hoffman2-4.2.2-gcc10"
export OMP_NUM_THREADS=1 OMP_THREAD_LIMIT=1 OMP_DYNAMIC=FALSE MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
sha256sum -c New_simulations/dm_apt50k_fresh_v1/inputs/bundle_files.sha256
echo "FRESH50K job=$JOB_ID task=$SGE_TASK_ID host=$(hostname) slots=$NSLOTS start=$(date --iso-8601=seconds)"
Rscript New_simulations/dm_apt50k_fresh_v1/run_task.R --task="$SGE_TASK_ID" --workers="$NSLOTS"
echo "FRESH50K COMPLETE job=$JOB_ID task=$SGE_TASK_ID end=$(date --iso-8601=seconds)"
