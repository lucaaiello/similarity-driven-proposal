#!/bin/bash
#$ -cwd
#$ -j y
#$ -o New_simulations/dm_apt50k_fresh_v1/hoffman2/logs/audit.$JOB_ID.log
#$ -N apt50_audit
#$ -l highp,h_rt=3:00:00,h_data=4G,h_vmem=40G
#$ -pe shared 10
set -euo pipefail
. /u/local/Modules/default/init/modules.sh
module load gcc/10.2.0
module load R/4.2.2
export R_LIBS_USER="$HOME/R/hoffman2-4.2.2-gcc10"
export OMP_NUM_THREADS=1 OMP_THREAD_LIMIT=1 OMP_DYNAMIC=FALSE MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
sha256sum -c New_simulations/dm_apt50k_fresh_v1/inputs/bundle_files.sha256
echo "AUDIT ONLY job=$JOB_ID host=$(hostname) slots=$NSLOTS start=$(date --iso-8601=seconds)"
Rscript New_simulations/dm_apt_runtime_optimization/verify.R --mode=full --workers=10 --output=New_simulations/dm_apt50k_fresh_v1/engine_audit
Rscript New_simulations/dm_apt50k_fresh_v1/audit.R --workers=10 --output=New_simulations/dm_apt50k_fresh_v1/audit
echo "FRESH50K AUDITS COMPLETE job=$JOB_ID end=$(date --iso-8601=seconds)"
